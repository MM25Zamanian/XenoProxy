location ~ ^/api/ {
  proxy_pass http://$NEXT_HOST:$NEXT_PORT;
  proxy_no_cache 1;
  proxy_cache_bypass 1;
}
location ~ ^/_next/data/ {
  proxy_pass http://$NEXT_HOST:$NEXT_PORT;
  proxy_no_cache 1;
  proxy_cache_bypass 1;
}

location / {
  include /etc/nginx/conf.d/location.d/root.d/*.conf;

  try_files $uri @nextjs;
}
